+function createParagraph(listInterrupt: string) {
+  return edit(_paragraph)
+    .replace('hr', hr)
+    .replace('heading', ' {0,3}#{1,6}(?:\\s|$)')
+    .replace('|lheading', '') // setext headings don't interrupt commonmark paragraphs
+    .replace('|table', '')
+    .replace('blockquote', ' {0,3}>')
+    .replace('fences', ' {0,3}(?:`{3,}(?=[^`\\n]*\\n)|~{3,})[^\\n]*\\n')
+    .replace('list', listInterrupt)
+    .replace('html', '</?(?:tag)(?: +|\\n|/?>)|<(?:script|pre|style|textarea|!--)')
+    .replace('tag', _tag); // pars can be interrupted by type (6) html blocks
+}
+
+// only non-empty lists starting from 1 can interrupt a paragraph
+const paragraph = createParagraph(' {0,3}(?:[*+-]|1[.)])[ \\t]+[^ \\t\\n]').getRegex();
+
+// In a blockquote, a line starting with a list marker ends the blockquote
+// (the list becomes a sibling block), so any list marker can interrupt the
+// paragraph, even one without content
+const blockquoteParagraph = createParagraph(' {0,3}(?:[*+-]|\\d{1,9}[.)])(?=[ \\t\n]|$)').getRegex();
 
 const blockquote = edit(/^( {0,3}> ?(paragraph|[^\n]*)(?:\n|$))+/)
