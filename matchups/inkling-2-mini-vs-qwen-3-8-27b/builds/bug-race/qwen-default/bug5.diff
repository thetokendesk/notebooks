+++ b/tmp-repro/diff.mjs
@@ -0,0 +1,114 @@
+import { marked } from '../lib/marked.esm.js';
+import { Parser, HtmlRenderer } from 'commonmark';
+
+const parser = new Parser();
+const renderer = new HtmlRenderer();
+
+// Normalize for comparison: collapse whitespace, strip trailing newline
+function norm(s) {
+  return s.replace(/\n+$/,'').replace(/\s+/g,' ').trim();
+}
+
+const cases = [
+  // reported bug cases
+  '1. test\n> blockquote\n2. test\n> blockquote',
+  '> blockquote\n2. test',
+  '> blockquote\n- test',
+  '> blockquote\n\n2. test',
+  '> blockquote\n    2. test',
+  '> a\n> 1. b\n>    c',
+  // ordered lists after blockquote
+  '> foo\n1. bar',
+  '> foo\n2. bar',
+  '> foo\n10. bar',
+  '> foo\n100. bar',
+  '> foo\n   2. bar',
+  '> foo\n  2.  bar',
+  '> foo\n2) bar',
+  '> foo\n2)\tbar',
+  '> foo\n-\tbar',
+  '> foo\n* bar',
+  '> foo\n+ bar',
+  // lazy continuation that must be preserved
+  '> foo\nbar',
+  '> foo\nbar\n2. baz',
+  '> foo\nbar\nbaz',
+  '> foo\n2. bar\nbaz',
+  '> foo\n    bar',
+  '> foo\n\tbar',
+  '> foo\n===',
+  '> foo\n---',
+  '> foo\n\nbar',
+  // lists inside blockquotes followed by list lines
+  '> - foo\n- bar',
+  '> - foo\n2. bar',
+  '> 1. foo\n2. bar',
+  '> 2. foo\n3. bar',
+  '> 1. foo\n- bar',
+  '> 1. foo\n1. bar',
+  '> 1. foo\n> 2. bar',
+  // lazy continuation into list items inside blockquotes
+  '> 1. foo\nbar',
+  '> - foo\nbar',
+  '> 1. foo\n    bar',
+  '> 1. foo\n\nbar',
+  '> - foo\n\nbar',
+  // headings / other blocks inside blockquote followed by lines
+  '> # h\n2. bar',
+  '> # h\nbar',
+  '> # h\n- bar',
+  '>     code\n2. bar',
+  '> ```\n> x\n> ```\n2. bar',
+  '> <div>\n2. bar',
+  // nested blockquotes
+  '> > foo\n2. bar',
+  '> > foo\n> > bar',
+  '>> foo\n2. bar',
+  '> > 1. foo\n> 2. bar',
+  '> > 1. foo\n> > 2. bar',
+  '> 1. > foo\n>    bar\n2. baz',
+  // lists before/around blockquotes
+  '- foo\n> bar\n- baz',
+  '1. foo\n> bar\n1. baz',
+  '- foo\n> bar\n2. baz',
+  '> bar\n- foo\n> bar',
+  '> bar\n1. foo\n> bar',
+  '> bar\n10. foo\n> bar',
+  // top-level paragraph interruption (must still only be 1.)
+  'foo\n2. bar',
+  'foo\n1. bar',
+  'foo\n- bar',
+  // mixed
+  '> 1. foo\n> 2. bar\n3. baz',
+  '> - foo\n> - bar\n- baz',
+  '> - foo\n\n- bar',
+  '> 1. foo\n\n2. bar',
+  // empty-ish list markers
+  '> foo\n-',
+  '> foo\n2.',
+  '> foo\n2. ',
+  '> foo\n- bar\nbaz',
+  '> foo\n2. bar\nbaz',
+  // indented blockquote markers
+  '  > foo\n2. bar',
+  '   > foo\n2. bar',
+  '> foo\n  > bar\n2. baz',
+  // task lists / gfm
+  '> - [ ] foo\n2. bar',
+  '> 1. foo\n> 2. bar\n> 3. baz\n4. qux',
+];
+
+let fail = 0;
+for (const md of cases) {
+  const expected = norm(renderer.render(parser.parse(md)));
+  const options = { gfm: true };
+  const actual = norm(marked.parse(md, options));
+  if (expected !== actual) {
+    fail++;
+    console.log('MISMATCH for ' + JSON.stringify(md));
+    console.log('--- expected ---\n' + expected);
+    console.log('--- actual ---\n' + actual);
+    console.log();
+  }
+}
+console.log(fail === 0 ? `ALL ${cases.length} CASES MATCH` : `${fail}/${cases.length} mismatches`);
