+import { marked } from '../lib/marked.esm.js';
+
+const cases = [
+  '1. test\n> blockquote\n2. test\n> blockquote',
+  '> blockquote\n2. test',
+  '> blockquote\n- test',
+  '> blockquote\n\n2. test',
+];
+
+for (const md of cases) {
+  console.log('=== INPUT ===');
+  console.log(md);
+  console.log('--- HTML ---');
+  console.log(marked.parse(md, { gfm: true, breaks: true }));
+  console.log('--- TOKENS ---');
+  console.log(JSON.stringify(marked.lexer(md, { gfm: true, breaks: true }), null, 1));
+  console.log();
+}
